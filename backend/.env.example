# ──────────────────────────────────────────────
# exchanged — Environment Variables
# ──────────────────────────────────────────────

# Server
NODE_ENV=development
PORT=5000

# Neon PostgreSQL
DATABASE_URL=postgresql://user:password@ep-xxxx.us-east-2.aws.neon.tech/exchanged?sslmode=require

# Upstash Redis
UPSTASH_REDIS_URL=https://xxxx.upstash.io
UPSTASH_REDIS_TOKEN=your_upstash_token

# Redis (for BullMQ — Upstash Redis connection string)
REDIS_HOST=xxxx.upstash.io
REDIS_PORT=6379
REDIS_PASSWORD=your_redis_password

# JWT
JWT_SECRET=your_super_secret_key_change_this
JWT_EXPIRES_IN=7d

# CoinGecko
COINGECKO_BASE_URL=https://api.coingecko.com/api/v3
COINGECKO_API_KEY=

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# CORS
CORS_ORIGIN=http://localhost:3000
