          "name": "Get Global Market Data",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/markets/global",
              "host": ["{{baseUrl}}"],
              "path": ["api", "markets", "global"]
