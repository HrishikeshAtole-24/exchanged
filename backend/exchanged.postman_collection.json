        {
          "name": "Search",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/markets/search?q=solana",
              "host": ["{{baseUrl}}"],
              "path": ["api", "markets", "search"],
              "query": [
                { "key": "q", "value": "solana", "description": "Search query (coin name, symbol, or exchange)" }
              ]
            },
            "description": "Search for coins, categories, and exchanges."
          }
        }
      ]
    },
